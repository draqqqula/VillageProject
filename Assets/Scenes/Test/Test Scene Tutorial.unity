  m_text: "\u041B\u041A\u041C - \u0443\u0434\u0430\u0440\n\u0417\u0430\u0436\u043C\u0438\u0442\u0435
    Shift \u0447\u0442\u043E\u0431\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u0443\u0434\u0430\u0440\u0430.
    \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0447\u0442\u043E\u0431\u044B
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435.\n\n\u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435
    \u043C\u044B\u0448\u044C \u0432\u043F\u0440\u0430\u0432\u043E \u0438\u043B\u0438
    \u0432\u043B\u0435\u0432\u043E \u0434\u043B\u044F \u0443\u0434\u0430\u0440\u0430
    \u0432 \u043D\u0443\u0436\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u0438\u043B\u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
    \u043A\u0443\u0440\u0441\u043E\u0440 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    \u0434\u043B\u044F \u043A\u043E\u043B\u044E\u0449\u0435\u0439 \u0430\u0442\u0430\u043A\u0438"
