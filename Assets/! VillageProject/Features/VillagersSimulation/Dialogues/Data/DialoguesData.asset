  <Dialogues>k__BackingField:
  - <DialogueID>k__BackingField: HightLoyaltyVillage
    <Replicas>k__BackingField:
    - <Text>k__BackingField: "\u0421\u043B\u0443\u0448\u0430\u0439, \u0434\u0435\u0440\u0435\u0432\u043D\u044F
        \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
        \u0431\u0443\u0434\u0442\u043E \u043E\u0436\u0438\u043B\u0430."
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 3.0666666
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0414\u0430, \u043F\u043E\u0440\u044F\u0434\u043E\u043A
        \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044F. \u0414\u0430\u0436\u0435
        \u043D\u043E\u0447\u044C\u044E \u0441\u0442\u0430\u043B\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
      <SpeakerID>k__BackingField: 1
      <ReplicaDuration>k__BackingField: 3.4666667
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0418 \u043B\u044E\u0434\u0438 \u043A\u0430\u043A-\u0442\u043E
        \u0431\u043E\u0434\u0440\u0435\u0435 \u0441\u0442\u0430\u043B\u0438. \u0418
        \u0440\u0430\u0431\u043E\u0442\u0430 \u0438\u0434\u0451\u0442 \u043B\u0435\u0433\u0447\u0435
        \u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
      <SpeakerID>k__BackingField: 1
      <ReplicaDuration>k__BackingField: 3.8666666
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u0434\u0430\u043B\u044C\u0448\u0435
        \u0431\u0443\u0434\u0435\u0442 \u043B\u0443\u0447\u0448\u0435?"
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 1.8666667
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0415\u0441\u043B\u0438 \u0442\u0430\u043A \u043F\u043E\u0439\u0434\u0451\u0442
        \u2014 \u0434\u0430. \u041C\u044B \u0443\u0436\u0435 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
        \u0432\u044B\u0436\u0438\u0432\u0430\u0435\u043C."
      <SpeakerID>k__BackingField: 1
      <ReplicaDuration>k__BackingField: 3.2
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u042D\u0442\u043E \u0442\u043E\u0447\u043D\u043E\u2026
        \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430 \u0434\u043E\u043B\u0433\u043E\u0435
        \u0432\u0440\u0435\u043C\u044F \u0435\u0441\u0442\u044C \u0447\u0443\u0432\u0441\u0442\u0432\u043E,
        \u0447\u0442\u043E \u0432\u0441\u0451 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
        \u043A\u0440\u0435\u043F\u043A\u043E."
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 4.866667
      _isAutoDuration: 1
  - <DialogueID>k__BackingField: MediumLoyaltyVillage
    <Replicas>k__BackingField:
    - <Text>k__BackingField: "\u0412 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u0432\u0441\u0451
        \u0438\u0434\u0451\u0442 \u0441\u0432\u043E\u0438\u043C \u0447\u0435\u0440\u0435\u0434\u043E\u043C."
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 2.2
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0414\u0430, \u043D\u0438 \u0445\u0443\u0436\u0435,
        \u043D\u0438 \u043B\u0443\u0447\u0448\u0435. \u041A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E."
      <SpeakerID>k__BackingField: 1
      <ReplicaDuration>k__BackingField: 2.2666667
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0420\u0430\u0431\u043E\u0442\u044B \u0445\u0432\u0430\u0442\u0430\u0435\u0442,
        \u043D\u043E \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0435\u0439 \u0441\u043F\u0435\u0448\u043A\u0438."
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 2.4666667
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435, \u0447\u0442\u043E
        \u0432\u0441\u0451 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
      <SpeakerID>k__BackingField: 1
      <ReplicaDuration>k__BackingField: 2.3333333
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0447\u0442\u043E \u0434\u043D\u0438 \u0432\u0441\u0435 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0435."
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 2.6
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0417\u0430\u0442\u043E \u043D\u0435\u0442 \u043B\u0438\u0448\u043D\u0438\u0445
        \u0431\u0435\u0434 \u2014 \u0438 \u044D\u0442\u043E \u0443\u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u043E."
      <SpeakerID>k__BackingField: 1
      <ReplicaDuration>k__BackingField: 2.6
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442\u2026
        \u043F\u043E\u043A\u0430 \u0432\u0441\u0451 \u0441\u0442\u043E\u0438\u0442
        \u043D\u0430 \u0441\u0432\u043E\u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u0445."
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 2.8
      _isAutoDuration: 1
  - <DialogueID>k__BackingField: LowLoyaltyVillage
    <Replicas>k__BackingField:
    - <Text>k__BackingField: "\u0422\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B,
        \u0447\u0442\u043E \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043A\u0430\u043A-\u0442\u043E
        \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D\u043D\u043E \u0441\u0442\u0430\u043B\u043E?"
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 3.3333333
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0410 \u043A\u043E\u0433\u0434\u0430 \u0442\u0443\u0442
        \u0431\u044B\u043B\u043E \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443
        \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
        \u0432\u0440\u0435\u043C\u044F?"
      <SpeakerID>k__BackingField: 1
      <ReplicaDuration>k__BackingField: 3.8666666
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0420\u0430\u043D\u044C\u0448\u0435 \u0445\u043E\u0442\u044F
        \u0431\u044B \u0431\u044B\u043B\u043E \u044F\u0441\u043D\u043E, \u0447\u0435\u0433\u043E
        \u0436\u0434\u0430\u0442\u044C. \u0421\u0435\u0439\u0447\u0430\u0441 \u0432\u0441\u0451
        \u0431\u0443\u0434\u0442\u043E \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
        \u043D\u0430 \u0442\u043E\u043D\u043A\u043E\u0439 \u043D\u0438\u0442\u0438."
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 5
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u041B\u044E\u0434\u0438 \u0442\u043E\u0436\u0435 \u044D\u0442\u043E
        \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E\u0442. \u041A\u0430\u0436\u0434\u044B\u0439
        \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435, \u043A\u0430\u043A
        \u0431\u0443\u0434\u0442\u043E \u0436\u0434\u0443\u0442 \u0431\u0435\u0434\u044B."
      <SpeakerID>k__BackingField: 1
      <ReplicaDuration>k__BackingField: 4.3333335
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u0432\u0441\u0451
        \u0441\u043E\u0432\u0441\u0435\u043C \u043F\u043B\u043E\u0445\u043E?"
      <SpeakerID>k__BackingField: 0
      <ReplicaDuration>k__BackingField: 1.7333333
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u041D\u0435 \u0437\u043D\u0430\u044E. \u041D\u043E
        \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043D\u0435\u0442
        \u043D\u0438 \u0443 \u043A\u043E\u0433\u043E."
      <SpeakerID>k__BackingField: 1
      <ReplicaDuration>k__BackingField: 2.5333333
      _isAutoDuration: 1
    - <Text>k__BackingField: "\u0415\u0441\u043B\u0438 \u0442\u0430\u043A \u0434\u0430\u043B\u044C\u0448\u0435
        \u043F\u043E\u0439\u0434\u0451\u0442\u2026 \u0414\u0435\u0440\u0435\u0432\u043D\u044F
        \u0434\u043E\u043B\u0433\u043E \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442."
      <SpeakerID>k__BackingField: 0
